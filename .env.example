# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase project URL (e.g. https://xxxx.supabase.co)
SUPABASE_URL=""

# SUPABASE_ANON_KEY: Public anonymous key for client-side Supabase Auth, Realtime & Edge Functions
SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Optional backend Express server key ONLY (auto-injected inside Supabase Edge Functions).
# NEVER add SUPABASE_SERVICE_ROLE_KEY to GitHub Actions Secrets or frontend builds.
SUPABASE_SERVICE_ROLE_KEY=""

# SSG_SYNC_SECRET: Self-generated random string (e.g. `openssl rand -hex 32`) set identically in
# GitHub Actions Secrets and Supabase Edge Function Secrets (scoped ONLY to `sync-ssg-index`).
# (Pix creator keys are NEVER stored as env secrets — each user registers their own Pix key dynamically.)
SSG_SYNC_SECRET=""

# GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET: Optional direct Google OAuth 2.0 credentials (if not using Supabase Auth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SESSION_SECRET: HMAC signing secret for server-issued Bearer tokens (auto-generated in memory if empty)
SESSION_SECRET=""
